# Fieldkit Environment Configuration

# Core Infrastructure
ENVIRONMENT=development
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Database (Postgres 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fieldkit
POSTGRES_USER=fieldkit
POSTGRES_PASSWORD=fieldkit_dev_insecure
DATABASE_URL=postgresql+asyncpg://fieldkit:fieldkit_dev_insecure@localhost:5432/fieldkit

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Keycloak (SSO / Auth)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=halden
KEYCLOAK_CLIENT_ID=api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/halden/protocol/openid-connect/certs

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./.cache/llm

# Service Ports
PORT_CONSOLE=3000
PORT_FOUNDRY=8001
PORT_ASSISTANT=8002
PORT_COPILOT=8003
PORT_DOCAI=8004
PORT_VISION=8005
PORT_TRACEHUB=8006
PORT_WORKFLOW=8007
PORT_KEYCLOAK=8080

# MinIO Object Storage (Landing Zone)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_LANDING=foundry-landing
PORT_MINIO_API=9000
PORT_MINIO_CONSOLE=9001

# Mock SOAP Service
MOCK_SOAP_URL=http://localhost:8010/ws/supplier-certificates
PORT_MOCK_SOAP=8010
