      "options": { "cellHeight": "sm", "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ClickHouse" },
          "rawSql": "SELECT service, route, plant, sum(error_count) AS errors, sum(call_count) AS total_requests, round((sum(error_count) / max2(1, sum(call_count))) * 100.0, 2) AS error_pct FROM fieldkit_tracehub.metrics_1m WHERE window_start >= $__fromTime AND window_start <= $__toTime AND error_count > 0 GROUP BY service, route, plant ORDER BY errors DESC LIMIT 20",
