      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ClickHouse" },
          "rawSql": "SELECT window_start AS time, quantilesMerge(0.95)(latency_quantiles)[1] AS p95_latency, 1500.0 AS slo_target FROM fieldkit_tracehub.metrics_1m WHERE window_start >= $__fromTime AND window_start <= $__toTime GROUP BY window_start ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "P95 Latency vs 1,500ms SLO Target",
      "type": "timeseries"
    },
