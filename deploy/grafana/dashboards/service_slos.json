          "rawSql": "SELECT window_start AS time, ((sum(error_count) / max2(1, sum(call_count))) / 0.005) AS burn_rate_1h, 14.4 AS critical_threshold FROM fieldkit_tracehub.metrics_1m WHERE window_start >= $__fromTime AND window_start <= $__toTime GROUP BY window_start ORDER BY time",
          "refId": "A"
