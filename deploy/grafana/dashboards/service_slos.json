          "rawSql": "SELECT plant, quantilesMerge(0.95)(latency_quantiles)[1] AS p95_latency FROM fieldkit_tracehub.metrics_1m WHERE window_start >= $__fromTime AND window_start <= $__toTime GROUP BY plant ORDER BY p95_latency DESC",
